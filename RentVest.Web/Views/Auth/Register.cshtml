@model RentVest.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="font-weight-light my-2"><i class="bi bi-person-plus-fill"></i> Create Account</h3>
                </div>
                <div class="card-body p-4">

                    <!-- Display API Errors here -->
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <form asp-action="Register" method="post">

                        <!-- Username -->
                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control" placeholder="Enter username" />
                            <label asp-for="Username"></label>
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" placeholder="Password" />
                            <label asp-for="Password"></label>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                            <label asp-for="ConfirmPassword"></label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Register</button>
                            <!--redirect to home-->
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <small>Have an account? <a asp-action="Login">Go to login</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- This enables Client-Side Validation (checks fields before sending to server) -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/users/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/users/register",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Users/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/users/login",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Recommendation/recommend",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/recommendation/generate",
      "UpstreamHttpMethod": [ "POST" ],
      "UpstreamHeaderTransform": {
        "Authorization": "{Authorization}"
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "5s",
        "PeriodTimespan": 1,
        "Limit": 5
      }
    },
    {
      "DownstreamPathTemplate": "/api/data/fetch-history/{symbol}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/data/fetch-history/{symbol}",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/AlphaVantageData/delete-history/{symbol}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/data/delete-history/{symbol}",
      "UpstreamHttpMethod": [ "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/Users/all",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5095
        }
      ],
      "UpstreamPathTemplate": "/gateway/admin/users",
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamHeaderTransform": {
        "Authorization": "{Authorization}"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5058"
  }
}